# BELBEAUTY LAB INFINITY -.htaccess FOR INFINITYFREE
# by Progress Tech - Ultimate config

RewriteEngine On

# Security headers
<IfModule mod_headers.c>
Header set X-Powered-By "Belbeauty LAB Infinity by Progress Tech"
Header set X-Creator "Progress Tech - Bamenda, Cameroon"
Header set X-Frame-Options "SAMEORIGIN"
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Force HTTPS if available (InfinityFree supports)
<IfModule mod_rewrite.c>
RewriteCond %{HTTP:X-Forwarded-Proto}!https
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST}!^localhost
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Block access to sensitive files
<FilesMatch "^\.env|\.git|composer\.|package\.json|belbeauty_logs">
Order allow,deny
Deny from all
</FilesMatch>

# Prevent directory listing
Options -Indexes

# Cache static assets (speed for InfinityFree)
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/svg+xml "access plus 1 month"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Compression (InfinityFree free plan supports gzip)
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# SPA fallback - If file doesn't exist, serve index.html (for chat routing)
RewriteCond %{REQUEST_FILENAME}!-f
RewriteCond %{REQUEST_FILENAME}!-d
RewriteCond %{REQUEST_URI}!^/api\.php
RewriteCond %{REQUEST_URI}!^/\.htaccess
RewriteRule ^(.*)$ index.html [L,QSA]

# Protect api.php - only allow POST
<Files "api.php">
<LimitExcept POST OPTIONS>
Order allow,deny
Deny from all
</LimitExcept>
</Files>

# Custom error page
ErrorDocument 404 /index.html
ErrorDocument 403 /index.html